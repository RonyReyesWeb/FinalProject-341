  "definitions": {
    "AuthorInput": {
      "type": "object",
      "required": [
        "firstName",
        "lastName",
        "birthDate",
        "nationality"
      ],
      "properties": {
        "firstName": {
          "type": "string",
          "example": "Brandon"
        },
        "lastName": {
          "type": "string",
          "example": "Sanderson"
        },
        "birthDate": {
          "type": "string",
          "format": "date",
          "example": "1975-12-19"
        },
        "nationality": {
          "type": "string",
          "example": "American"
        },
        "email": {
          "type": "string",
          "format": "email",
          "example": "brandon@example.com"
        }
      }
    },
    "Author": {
      "type": "object",
      "required": [
        "firstName",
        "lastName",
        "birthDate",
        "nationality"
      ],
      "properties": {
        "_id": {
          "type": "string",
          "example": "66fb1c2e8f1b2a3c4d5e6f70"
        },
        "firstName": {
          "type": "string",
          "example": "Brandon"
        },
        "lastName": {
          "type": "string",
          "example": "Sanderson"
        },
        "birthDate": {
          "type": "string",
          "format": "date",
          "example": "1975-12-19"
        },
        "nationality": {
          "type": "string",
          "example": "American"
        },
        "email": {
          "type": "string",
          "format": "email",
          "example": "brandon@example.com"
        }
      }
    },
    "BookInput": {
      "type": "object",
      "required": [
        "title",
        "authorId",
        "isbn",
        "genre",
        "publishedYear",
        "pages",
        "publisher"
      ],
      "properties": {
        "title": {
          "type": "string",
          "example": "Mistborn: The Final Empire"
        },
        "authorId": {
          "type": "string",
          "example": "66fb1c2e8f1b2a3c4d5e6f70",
          "description": "ObjectId of an existing author"
        },
        "isbn": {
          "type": "string",
          "example": "9780765311788",
          "description": "10 or 13 digits, no dashes"
        },
        "genre": {
          "type": "string",
          "example": "Fantasy"
        },
        "publishedYear": {
          "type": "integer",
          "example": 2006
        },
        "pages": {
          "type": "integer",
          "example": 541
        },
        "publisher": {
          "type": "string",
          "example": "Tor Books"
        },
        "available": {
          "type": "boolean",
          "example": true
        }
      }
    },
    "Book": {
      "type": "object",
      "required": [
        "title",
        "authorId",
        "isbn",
        "genre",
        "publishedYear",
        "pages",
        "publisher"
      ],
      "properties": {
        "_id": {
          "type": "string",
          "example": "66fb1c2e8f1b2a3c4d5e6f70"
        },
        "title": {
          "type": "string",
          "example": "Mistborn: The Final Empire"
        },
