MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/library
DB_NAME=library
PORT=3000

# GitHub OAuth (https://github.com/settings/developers -> New OAuth App)
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret
# Must match the callback URL in your GitHub OAuth app (/github/callback or /auth/github/callback both work)
CALLBACK_URL=http://localhost:3000/auth/github/callback

# Any long random string
SESSION_SECRET=change_me_to_a_long_random_string
